# Copy to apps/server/.env for local development.

PORT=8787
DATABASE_PATH=./data/sysarch.db

# Signs session cookies. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The URL the browser uses for /api. In dev the web app (5173) proxies /api to
# this server, so both point at the web origin. OAuth callbacks go to
# ${BETTER_AUTH_URL}/api/auth/callback/<provider>.
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# A provider is enabled when both values are set.
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enables the AI assistant (server-side only): https://console.anthropic.com/
ANTHROPIC_API_KEY=
